{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "docker:pinDigests"
    ],
    "dependencyDashboardAutoclose": true,
    "schedule": ["* 0-5 * * MON"],
    "labels": ["dependencies"],
    "packageRules": [{
        "description": "keep Docker image tags fixed",
        "matchDatasources": ["docker"],
        "versioning": "exact"
    }],
    "customManagers": [{
        "description": "update commit hashes for git-based dependencies",
        "customType": "regex",
        "managerFilePatterns": [
            "/(^|[/.])Dockerfile([.-][^/]*)?$/"
        ],
        "datasourceTemplate": "git-refs",
        "matchStrings": [
            "# renovate: depName=(?<depName>\\S+) packageName=(?<packageName>\\S+) currentValue=(?<currentValue>\\S+)\\r?\\nARG \\w+=(?<currentDigest>[0-9a-f]{40})"
        ]
    }]
}